# This is a example configuration file. You need to generate your configuration
# with the `cp .env.example .env`
APP_NAME=goodnews
APP_ENV=dev

# Mysql
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# Redis
REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

# The http server port
HTTP_SERVER_PORT=9501

# The websocket server port
WEBSOCKET_SERVER_PORT=9502

# ActivityPub
AP_HOST=good.news

# Email server
SMTP_SERVER=smtp.mailgun.org
SMTP_PORT=
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_AUTH_METHOD=
SMTP_OPENSSL_VERIFY_MODE=none
SMTP_ENABLE_STARTTLS=auto
SMTP_FROM_ADDRESS=

# Jwt, generate with `php bin/hyperf gen:auth-env`
AUTH_SSO_CLIENTS=h5,weapp
SSO_JWT_SECRET=EiahGHbMfaNQqaVt
SIMPLE_JWT_SECRET=7MpFib5FluAJqsJo

# File storage
FILE_STORAGE=s3
S3_KEY=
S3_SECRET=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=

# Attachment cdn domain name
ATTACHMENT_PREFIX=https://file.xxx.cn

# Default avatar url (optional)
DEFAULT_AVATAR=(null)

# This instance belongs to the domain name, multiple separated by commas
LOCAL_DOMAIN=.good.news

# Nsq
NSQ_HOST=127.0.0.1
NSQ_PORT=4150
NSQD_PORT=4151